--- autorun/qol-run.sh
+++ autorun/qol-run.sh
@@ -5,6 +5,12 @@
 echo $$ > /run/qol-run.pid
 
 cp "$DIR/mpcqol.so" "$SO" 2>/dev/null
+# fm1mix: open FM1 DX7 synth mixed into the app (see fm1/README.md)
+FM1SO=
+if [ -f "$DIR/fm1/fm1mix.so" ]; then
+    cp "$DIR/fm1/fm1mix.so" /tmp/fm1mix.so 2>/dev/null && chmod 644 /tmp/fm1mix.so && FM1SO=/tmp/fm1mix.so
+    export FM1MIX_DIR="$DIR/fm1"
+fi
 chmod 644 "$SO" 2>/dev/null
 [ -f "$SO" ] || exit 0
 
@@ -52,9 +58,10 @@
     [ -n "$SNAPSH" ] && { sh "$SNAPSH" watch & WATCH=$!; }
     ( ulimit -S -s 1024
       export MALLOC_ARENA_MAX=1
-      export LD_PRELOAD="$SO"
+      export LD_PRELOAD="$SO${FM1SO:+:$FM1SO}"
       setarch -R -- "$STOCK" )
     CODE=$?
+    [ -n "$FM1SO" ] && cp /tmp/fm1mix.log "$DIR/fm1/fm1mix.log" 2>/dev/null
     if [ -n "$WATCH" ]; then
         kill "$WATCH" 2>/dev/null
         wait "$WATCH" 2>/dev/null
